# Required: generate a long random secret and keep it private.
ATLAS_VOICE_ENGINE_TOKEN=replace-with-a-long-random-secret

# Kokoro 82M Brazilian Portuguese. Provisional male voice for evaluation only.
# pm_santa / pm_alex are not the final institutional ENAT voice.
ATLAS_VOICE_LANGUAGE=p
ATLAS_VOICE_ID=pm_santa
ATLAS_VOICE_SPEED=1.0
ATLAS_VOICE_MAX_CHARS=30000
ATLAS_VOICE_CHUNK_CHARS=650
ATLAS_VOICE_SAMPLE_RATE=24000
